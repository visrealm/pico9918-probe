; SPDX-License-Identifier: MIT
; Two FIFO words per byte: pin/direction command, then setup/pulse/hold loops.
; DMA supplies and drains all words. No CPU instruction is inside a bus pulse.
.program hb_write
.wrap_target
    pull block
    out pins, 12
    out pindirs, 12      ; data OE plus control OE: RP2350 replaces this SM's OE write set
    pull block
    out x, 8
setup:
    jmp x-- setup
    set pins, 1          ; /CSR=1, /CSW=0
    out x, 8
pulse:
    jmp x-- pulse
    set pins, 3
    out x, 8
hold:
    jmp x-- hold
    mov isr, null
    push block
.wrap

.program hb_read
.wrap_target
    pull block
    out pindirs, 12      ; release data, retain control OE, BEFORE /CSR
    out pins, 12
    pull block
    out x, 8
setup:
    jmp x-- setup
    set pins, 2          ; /CSR=0, /CSW=1
    out x, 8
presample:
    jmp x-- presample
    in pins, 8           ; sample while the target is actively driving
    out x, 8
postsample:
    jmp x-- postsample
    set pins, 3
    out x, 8
hold:
    jmp x-- hold
    push block
.wrap

.program hb_counter
.wrap_target
    wait 0 pin 0
    wait 1 pin 0
    jmp x-- 0
.wrap

.program hb_trace
    wait 0 gpio 12      ; patched to selected trigger pin before arming
.wrap_target
    in pins, 18         ; GP4..GP21
    push block
.wrap

; Raw timing experiments: one FIFO word per event, pins[11:0] | dirs[23:12] |
; duration[31:24]. Autopull at 32 refills exactly at the wrap and autopush at 8
; returns the sample, so neither PULL nor PUSH costs an instruction.
;
; LOAD-BEARING: five instructions means an event is 5+duration ticks. At 200 MHz
; that is the only reason the datasheet's 30, 100 and 200 ns are representable at
; all - 6, 20 and 40 ticks exactly. An extra instruction here raises the floor
; above 30 ns and makes the conformance gate untestable rather than merely coarse.
;
; The 12-bit pindirs write is also load-bearing. Narrowing it to the 8 data pins
; releases GP12-GP15 and drops the bus.
.program hb_events
.wrap_target
    out pins, 12
    out pindirs, 12
    out x, 8
delay:
    jmp x-- delay
    in pins, 8
.wrap

; One strobe excursion of runtime width against an otherwise static bus, for the
; glitch-rejection sweeps. Both levels are side-set, so the same program covers a
; LOW pulse that must not start an access and a HIGH excursion inside an asserted
; strobe that must not end one.
;
; Every side-set field here is patched before arming: the resting level on all of
; them, the excursion level on the one marked below. `jmp x--` with x = 0 still
; executes once, so the narrowest excursion is a single cycle, 5 ns at 200 MHz,
; comfortably under both the ~4 ns the target's synchroniser needs and the 35.7 ns
; it confirms a strobe over.
.program hb_pulse
.side_set 2
    pull block          side 0
    out pins, 12        side 0
    out pindirs, 12     side 0
    pull block          side 0
    out x, 10           side 0
pre:
    jmp x-- pre         side 0
    out x, 10           side 0
public excursion:
    jmp x-- excursion   side 0      ; patched to the excursion level
    out x, 10           side 0
post:
    jmp x-- post        side 0
    in pins, 8          side 0
    push block          side 0
